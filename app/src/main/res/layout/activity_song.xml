<?xml version="1.0" encoding="utf-8"?>
<!-- SONG LIST: logo on top, plain song tiles (title only). -->
<!-- outer frame: keeps the screen below the status bar / above the nav bar (fitsSystemWindows),
     inner LinearLayout keeps its own padding -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brain_cream"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:background="@color/brain_cream"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="24dp"
        android:paddingEnd="28dp"
        android:paddingBottom="20dp">

        <ImageView
            android:id="@+id/logoImage"
            android:src="@drawable/logo_braintune"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:layout_width="wrap_content"
            android:layout_height="130dp"
            android:contentDescription="brainTUNE" />

        <TextView
            style="@style/BrainTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Pick a song" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/song1Btn"
            style="@style/BrainTile"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="0dp"
            android:background="@drawable/bg_tile_burgundy"
            android:text="Zawsze tam gdzie ty" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/song2Btn"
            style="@style/BrainTile"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_tile_slate"
            android:text="When I'm Gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/song3Btn"
            style="@style/BrainTile"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_tile_mauve"
            android:text="Stay With Me" />

        <ImageView
            android:id="@+id/brainSong"
            android:layout_width="wrap_content"
            android:layout_height="110dp"
            android:layout_marginTop="20dp"
            android:adjustViewBounds="true"
            android:contentDescription="Brain"
            android:scaleType="fitCenter"
            android:src="@drawable/brain_karaoke" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            style="@style/BrainHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⬆ ⬇  move   ·   ➡  play" />

        <TextView
            android:id="@+id/exitHintText"
            style="@style/BrainHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="blink twice to exit" />
    </LinearLayout>
</FrameLayout>