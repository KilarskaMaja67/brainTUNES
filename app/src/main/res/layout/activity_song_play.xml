<?xml version="1.0" encoding="utf-8"?>
<!-- PLAY ALONG: title + progress, chord lane (tiles slide left to the hit zone),
     lyrics (whole lines fade in/out), combo, small chord cross. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    style="@style/BrainScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/songTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/brain_muted"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/songProgress"
        style="@style/BrainProgress"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="28dp"
        android:progressDrawable="@drawable/progress_brain_teal" />

    <!-- CHORD LANE: tiles are added in code and moved with translationX every frame -->
    <FrameLayout
        android:id="@+id/chordLane"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_lane"
        android:clipChildren="true">

        <!-- the "now" spot: a chord should be played when its tile is here -->
        <View
            android:id="@+id/hitZone"
            android:layout_width="66dp"
            android:layout_height="74dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="36dp"
            android:background="@drawable/bg_hitzone" />
    </FrameLayout>

    <!-- LYRICS: current line big, next line small and faded -->
    <TextView
        android:id="@+id/tvLyricsCurrent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:maxLines="2"
        android:minLines="2"
        android:textColor="@color/brain_ink"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLyricsNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="24dp"
        android:alpha="0.6"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/brain_muted"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvCombo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text=" "
        android:textColor="@color/brain_green"
        android:textSize="17sp"
        android:textStyle="bold" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include layout="@layout/chord_cross_small" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/exitHintText"
        style="@style/BrainHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="blink twice to exit" />
</LinearLayout>
