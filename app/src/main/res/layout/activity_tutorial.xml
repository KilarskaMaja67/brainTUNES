<?xml version="1.0" encoding="utf-8"?>
<!-- Samouczek: naglowek fazy, pasek postepu, polecenie, strzalka, podpowiedz, komunikat. Bez przyciskow akordow. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvFaza"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Faza 1/3"
        android:textSize="16sp" />

    <ProgressBar
        android:id="@+id/pasekPostepu"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvPolecenie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text=""
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStrzalka"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="80sp" />

    <TextView
        android:id="@+id/tvPodpowiedz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text=""
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:minHeight="56dp"
        android:text=""
        android:textSize="20sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnJeszczeRaz"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Jeszcze raz"
        android:visibility="gone" />

    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/exitHintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="blink twice to exit"
        android:textSize="14sp" />

    <Button
        android:id="@+id/backBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Powrót" />

</LinearLayout>