<?xml version="1.0" encoding="utf-8"?>
<!-- TUTORIAL: phase header + progress, speech bubble (brain art + hint), task card (instruction, arrow, "to play G"),
     feedback, "Repeat tutorial" at the end. No chord tiles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    style="@style/BrainScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/tvPhase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/brain_muted"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/tutorialProgress"
        style="@style/BrainProgress"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="10dp" />

    <!-- speech bubble: brain drawing + hint text (hidden when there is no hint) -->
    <LinearLayout
        android:id="@+id/bubbleRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/brainTutorial"
            style="@style/BrainArtSlot"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Brain" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_bubble"
            android:padding="12dp"
            android:textColor="@color/brain_ink"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- task card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_card"
        android:gravity="center_horizontal"
        android:minHeight="220dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="22dp"
        android:paddingEnd="16dp"
        android:paddingBottom="22dp">

        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/brain_ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/brain_burgundy"
            android:textSize="72sp" />

        <!-- "to play [G]" - only in phase 1 -->
        <LinearLayout
            android:id="@+id/rowToPlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="to play"
                android:textColor="@color/brain_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChordChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnRepeat"
        style="@style/BrainTile"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_tile_burgundy"
        android:text="Repeat tutorial ➡"
        android:visibility="gone" />

    <TextView
        android:id="@+id/exitHintText"
        style="@style/BrainHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="blink twice to exit" />
</LinearLayout>
