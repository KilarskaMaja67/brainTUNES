<?xml version="1.0" encoding="utf-8"?>
<!-- MENU: logo, connection pill, 4 smaller buttons, each with its own brain drawing (alternating sides). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brain_cream"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <!-- LOGO -->
        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:adjustViewBounds="true"
            android:contentDescription="brainTUNE"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_braintune" />

        <TextView
            android:id="@+id/tvConnection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_pill_warn"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="● Waiting for the headband…"
            android:textColor="@color/brain_orange"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/brainConfig"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginEnd="14dp"
                android:adjustViewBounds="true"
                android:contentDescription="Brain"
                android:scaleType="fitCenter"
                android:src="@drawable/brain_config" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/configBtn"
                style="@style/BrainTile"
                android:layout_width="200dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_tile_burgundy"
                android:text="Calibrate"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/tutorialBtn"
                style="@style/BrainTile"
                android:layout_width="200dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_tile_teal"
                android:text="Tutorial"
                android:textSize="22sp" />

            <ImageView
                android:id="@+id/brainTutorial"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginStart="14dp"
                android:adjustViewBounds="true"
                android:contentDescription="Brain"
                android:scaleType="fitCenter"
                android:src="@drawable/brain_tutorial" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/brainPlay"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginEnd="14dp"
                android:adjustViewBounds="true"
                android:contentDescription="Brain"
                android:scaleType="fitCenter"
                android:src="@drawable/brain_music" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/playBtn"
                style="@style/BrainTile"
                android:layout_width="200dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_tile_mauve"
                android:text="Play"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/songBtn"
                style="@style/BrainTile"
                android:layout_width="200dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_tile_slate"
                android:text="Karaoke"
                android:textSize="22sp" />

            <ImageView
                android:id="@+id/brainSong"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginStart="14dp"
                android:adjustViewBounds="true"
                android:contentDescription="Brain"
                android:scaleType="fitCenter"
                android:src="@drawable/brain_karaoke" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            style="@style/BrainHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⬆ ⬇  move   ·   ➡  open" />
    </LinearLayout>
</FrameLayout>