<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="#FAF3D1">


    <Button
        android:id="@+id/playBtn"
        android:layout_width="250dp"
        android:layout_height="120dp"
        android:fontFamily="sans-serif-light"
        android:text="PLAY"
        android:textSize="40sp"
        app:backgroundTint="#6B2D2D"
        app:cornerRadius="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.552"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.648" />

    <Button
        android:id="@+id/tutorialBtn"
        android:layout_width="250dp"
        android:layout_height="120dp"
        android:fontFamily="sans-serif-light"
        android:text="TUTORIAL"
        android:textSize="40sp"
        app:backgroundTint="#3B6E8C"
        app:cornerRadius="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.552"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.332" />

    <ImageView
        android:id="@+id/logoImageView1"
        android:layout_width="107dp"
        android:layout_height="137dp"
        android:scaleType="centerCrop"
        android:src="@drawable/mozgtuto_"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.052"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.341" />

    <Button
        android:id="@+id/configBtn"
        android:layout_width="250dp"
        android:layout_height="120dp"
        android:fontFamily="sans-serif-light"
        android:text="CONFING"
        android:textSize="40sp"
        app:backgroundTint="#6B2D2D"
        app:cornerRadius="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.055" />


    <ImageView
        android:id="@+id/logoImageView2"
        android:layout_width="142dp"
        android:layout_height="179dp"
        android:scaleType="centerCrop"
        android:src="@drawable/mozgmusic"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.94"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.528" />

    <ImageView
        android:id="@+id/logoImageView3"
        android:layout_width="122dp"
        android:layout_height="117dp"
        android:scaleType="centerCrop"
        android:src="@drawable/mozgkonf"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/songBtn"
        android:layout_width="250dp"
        android:layout_height="120dp"
        android:fontFamily="sans-serif-light"
        android:text="SONG"
        android:textSize="40sp"
        app:backgroundTint="#3B6E8C"
        app:cornerRadius="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.602"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.937" />

    <ImageView
        android:id="@+id/logoImageView4"
        android:layout_width="131dp"
        android:layout_height="151dp"
        android:scaleType="centerCrop"
        android:src="@drawable/mozgsong"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.057"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.912" />
</androidx.constraintlayout.widget.ConstraintLayout>