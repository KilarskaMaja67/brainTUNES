<?xml version="1.0" encoding="utf-8"?>
<!-- MENU: logo on top, connection pill, 4 tiles with a slot for a brain drawing next to each (alternating sides). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    style="@style/BrainScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="24dp"
    android:paddingEnd="28dp"
    android:paddingBottom="20dp">

    <!-- LOGO: add android:src="@drawable/logo" and remove the style line -->
    <ImageView
        android:id="@+id/logoImage"
        style="@style/BrainArtSlot"
        android:layout_width="140dp"
        android:layout_height="110dp"
        android:contentDescription="Logo" />

    <TextView
        android:id="@+id/tvConnection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_pill_warn"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:text="● Waiting for the headband…"
        android:textColor="@color/brain_orange"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- row 1: art | Calibrate -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/brainConfig"
            style="@style/BrainArtSlot"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="Brain" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/configBtn"
            style="@style/BrainTile"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tile_burgundy"
            android:text="Calibrate" />
    </LinearLayout>

    <!-- row 2: Tutorial | art -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tutorialBtn"
            style="@style/BrainTile"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tile_slate"
            android:text="Tutorial" />

        <ImageView
            android:id="@+id/brainTutorial"
            style="@style/BrainArtSlot"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginStart="14dp"
            android:contentDescription="Brain" />
    </LinearLayout>

    <!-- row 3: art | Play -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/brainPlay"
            style="@style/BrainArtSlot"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="Brain" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/playBtn"
            style="@style/BrainTile"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tile_mauve"
            android:text="Play" />
    </LinearLayout>

    <!-- row 4: Songs | art -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/songBtn"
            style="@style/BrainTile"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tile_slate"
            android:text="Songs" />

        <ImageView
            android:id="@+id/brainSong"
            style="@style/BrainArtSlot"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginStart="14dp"
            android:contentDescription="Brain" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        style="@style/BrainHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⬆ ⬇  move   ·   ➡  open" />
</LinearLayout>
